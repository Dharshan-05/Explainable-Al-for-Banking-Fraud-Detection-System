# ============================================================
#  Root .env.example  —  Docker Compose environment template
# ============================================================

# PostgreSQL Database Settings
POSTGRES_USER=admin_placeholder
POSTGRES_PASSWORD=secure_password_placeholder
POSTGRES_DB=frauddb_placeholder

# Database URL Configuration (used by backend)
DATABASE_URL=postgresql+asyncpg://admin_placeholder:secure_password_placeholder@db:5432/frauddb_placeholder

# JWT Configuration
SECRET_KEY=generate_a_random_jwt_secret_key_for_production_here

# Redis URL Configuration
REDIS_URL=redis://redis:6379/0

# App Settings
DEBUG=false

# NextJS Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
