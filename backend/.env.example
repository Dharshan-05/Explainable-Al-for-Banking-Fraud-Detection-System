# ============================================================
#  backend/.env.example  —  Template for local environment
# ============================================================

# PostgreSQL Database Settings
POSTGRES_USER=admin_placeholder
POSTGRES_PASSWORD=secure_password_placeholder
POSTGRES_DB=frauddb_placeholder

# Database Configuration
DATABASE_URL=postgresql+asyncpg://admin_placeholder:secure_password_placeholder@localhost:5432/frauddb_placeholder

# JWT Configuration
SECRET_KEY=generate_a_random_jwt_secret_key_for_production_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis Configuration (Cache + Celery Broker)
REDIS_URL=redis://localhost:6379/0

# App Settings
APP_NAME="Fraud Detection XAI"
DEBUG=false
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
